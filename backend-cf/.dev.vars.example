# ── 必填：Worker 运行所需的环境变量 / secrets ──────────────────
# keypool 复用这两组 secrets（Key 一律来自 secrets，绝不硬编码/落日志）。
# embed_pool 与 llm_pool 各放一批 key，逗号分隔（key 只存 secret，不落库明文）。
EMBED_POOL_KEYS=sk-xxxx,sk-yyyy
LLM_POOL_KEYS=sk-aaaa,sk-bbbb

# ── Qdrant Cloud（可选，M0 探测用）──────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ── 可选覆盖 ────────────────────────────────────────────────
ADMIN_API_KEY=your_admin_key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 登录：X (Twitter) OAuth 2.0 + PKCE（T3.1）────────────────
# X 开发者后台 → User authentication settings → OAuth 2.0
# ⚠️ OAUTH_REDIRECT_URI 必须与 X 后台登记的 Redirect URI 完全一致（差一个字符就失败）
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
JWT_SECRET=用 openssl rand -hex 32 生成
# 线上（Worker）回调；本地联调改成 http://127.0.0.1:8787/api/v1/auth/oauth/x/callback
OAUTH_REDIRECT_URI=https://transhelper-prism-backend.transprism.workers.dev/api/v1/auth/oauth/x/callback
# 登录成功后回跳的前端；本地联调改成 http://localhost:3000
FRONTEND_BASE_URL=https://search.chengxi.moe
# 管理员 X 数字 id（逗号分隔），留空则所有人都是普通用户
ADMIN_X_IDS=

# 只用于 scripts/probe-connectivity.ts（本地运行时读环境变量，非 Worker secret）
PROBE_SILICONFLOW_API_KEY=sk-xxxx
# 注意：绝不可把真实 key 提交到仓库；.dev.vars 与 .env 均被 .gitignore 排除。
