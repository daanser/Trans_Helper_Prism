{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transhelper-prism-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transhelper-prism",
      "database_id": "57ade785-2c26-4050-926c-d3f96abe3c7b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SEARCH_CACHE",
      "id": "08db2f7b6a1344b89d3c148b7ffda74f"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "transhelper-prism-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "transhelper-prism-ingest",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "transhelper-prism-ingest-dlq"
      }
    ]
  },
  // 摄取（Cron/Queue）已迁到 GitHub Actions（.github/workflows/ingest.yml）：
  // Cloudflare 免费版 CPU 10ms / 内存 128MB / 50 子请求，Worker 内跑全量 ingest 必然超限。
  // 这里不再注册 crons，避免每晚产生无效失败；Worker 只负责搜索/树/corpora 等在线服务。
  "vars": {
    "ALLOWED_ORIGINS": "https://search.chengxi.moe,https://transhelper-prism.pages.dev",
    // 登录相关（非敏感项写进配置，避免被每次部署覆盖；敏感项 X_CLIENT_ID/X_CLIENT_SECRET/JWT_SECRET 放 Worker Secrets）
    "OAUTH_REDIRECT_URI": "https://transhelper-prism-backend.transprism.workers.dev/api/v1/auth/oauth/x/callback",
    "FRONTEND_BASE_URL": "https://search.chengxi.moe",
    // X OAuth scope：只取 id/username 够用。若登录报 x-users-me-failed，改成 "users.read tweet.read" 回滚
    "X_OAUTH_SCOPES": "users.read",
    "QUOTA_WINDOW_TOKENS": "300000",
    "QUOTA_WINDOW_HOURS": "5",
    // 匿名也允许向量检索（仅靠限流挡滥用）；要改成"仅回退"把这里设 "1"
    "REQUIRE_LOGIN": "0",
    "RATE_LIMIT_IP_PER_MIN": "10",
    "RATE_LIMIT_ACCOUNT_PER_MIN": "60",
    "LLM_MODEL": "Qwen/Qwen3.5-4B",
    "LLM_ENDPOINT": "https://api.siliconflow.cn/v1/chat/completions",
    "LLM_TIMEOUT_MS": "20000",
    "LLM_MAX_TOKENS": "800",
    "EMBEDDING_ENDPOINT": "https://api.siliconflow.cn/v1/embeddings",
    "EMBEDDING_MODEL": "BAAI/bge-m3",
    "EMBEDDING_DIM": "1024",
    "RERANK_ENDPOINT": "https://api.siliconflow.cn/v1/rerank",
    "RERANK_MODEL": "BAAI/bge-reranker-v2-m3"
  }
}
